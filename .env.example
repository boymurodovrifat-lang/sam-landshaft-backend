# Database
DATABASE_URL="postgresql://samlandshaft:samlandshaft@localhost:5432/sam_landshaft?schema=public"

# Server
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# File storage
UPLOAD_DIR=./storage/uploads
COG_DIR=./storage/cog
VIDEO_DIR=./storage/videos

# GDAL binary (optional, defaults to 'gdal_translate')
GDAL_BIN=gdal_translate

# FFMPEG binary
FFMPEG_BIN=ffmpeg

# CORS (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:5173,https://sam-landshaft.uz,https://admin.sam-landshaft.uz

# Admin (for seed)
SEED_ADMIN_EMAIL=admin@sam-landshaft.uz
SEED_ADMIN_PASSWORD=

# GDAL safety limits (per API process)
GDAL_MAX_CONCURRENT=2
GDAL_TIMEOUT_MS=120000
GDAL_CONVERT_TIMEOUT_MS=600000
GDAL_MAX_CROP_PIXELS=50000000
